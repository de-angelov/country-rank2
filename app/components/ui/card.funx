import { Slot } from "@radix-ui/react-slot"
import { cn } from "../../lib/utils.js"

export Card = (props: HtmlProps<"div"> & { asChild?: Boolean }) =>
  match props.asChild
    | true => <Slot data-slot="card" className={cn("flex flex-col gap-6 rounded-base border-2 border-border bg-background py-6 font-base text-foreground shadow-shadow", props.className)} {...props} />
    | _ => <div data-slot="card" className={cn("flex flex-col gap-6 rounded-base border-2 border-border bg-background py-6 font-base text-foreground shadow-shadow", props.className)} {...props} />

export CardHeader = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-header"
    className={cn("@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-[data-slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6", props.className)}
    {...props}
  />

export CardTitle = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-title"
    className={cn("font-heading leading-none", props.className)}
    {...props}
  />

export CardDescription = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-description"
    className={cn("text-sm font-base", props.className)}
    {...props}
  />

export CardAction = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-action"
    className={cn("col-start-2 row-span-2 row-start-1 self-start justify-self-end", props.className)}
    {...props}
  />

export CardContent = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-content"
    className={cn("px-6", props.className)}
    {...props}
  />

export CardFooter = (props: HtmlProps<"div">) =>
  <div
    data-slot="card-footer"
    className={cn("flex items-center px-6 [.border-t]:pt-6", props.className)}
    {...props}
  />
