import * as ProgressPrimitive from "@radix-ui/react-progress"
import { cn } from "../../lib/utils.js"

export Progress = (props: HtmlProps<"div"> & { indicatorClassName?: String, value?: Number }) =>
  <ProgressPrimitive.Root
    data-slot="progress"
    className={cn("relative h-4 w-full overflow-hidden rounded-base border-2 border-border bg-secondary-background shadow-shadow", props.className)}
    value={props.value}
    {...props}
  >
    <ProgressPrimitive.Indicator
      data-slot="progress-indicator"
      className={cn("h-full w-full flex-1 bg-main transition-all", props.indicatorClassName)}
      style={{ transform: "translateX(-{100 - (props.value or 0)}%)" }}
    />
  </ProgressPrimitive.Root>
