import { Country } from "../../countries/country.js"
import { cn } from "../../lib/utils.js"
import { CountryCard, CountryCardVoteIconSprite } from "../country-card/country-card.js"

export schema RankedCountriesListProps = {
  ariaLabel: String
  countries: Array<Country>
  rankNumberOrder: String = "highest-first"
  rankTone: String
}

export schema RankNumberInput = {
  index: Number
  order: Unknown = "highest-first"
  total: Number
}

export getDisplayedRankNumber = ({ index, order, total }: RankNumberInput) =>
  isLowest = match order
    | "lowest-first" => true
    | LowestFirst => true
    | _ => false
  => match isLowest
    | true => total - index
    | false => index + 1

export RankedCountriesList = ({ ariaLabel, countries, rankNumberOrder, rankTone }: SchemaInput<RankedCountriesListProps>) =>
  rankToneClass = match rankTone
    | "dislike" => "bg-vote-dislike"
    | _ => "bg-vote-like"
  => <>
    <CountryCardVoteIconSprite />
    <ol className="grid list-none gap-5 p-0" aria-label={ariaLabel}>
      {countries |> Array.map((country, index) => <li className="grid gap-2 sm:grid-cols-[minmax(9rem,12rem)_minmax(0,1fr)] sm:items-stretch sm:gap-4 lg:grid-cols-[minmax(12rem,14rem)_minmax(0,1fr)]" key={country.code}>
          <div
            className={cn("flex min-h-14 min-w-[4.5rem] items-center justify-center whitespace-nowrap rounded-base border-2 border-border px-4 py-2 text-7xl font-heading leading-none text-main-foreground shadow-shadow sm:h-full sm:min-h-full sm:px-4 sm:py-4", rankToneClass)}
            aria-label={"Rank " + getDisplayedRankNumber({ index: index, order: rankNumberOrder, total: countries.length })}
          >
            {getDisplayedRankNumber({ index: index, order: rankNumberOrder, total: countries.length })}
          </div>
          <CountryCard country={country} className="" includeVoteIconSprite={false} />
        </li>)}
    </ol>
  </>
