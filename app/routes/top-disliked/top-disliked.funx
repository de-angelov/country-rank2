import { Effect, Option, Schema, Record } from "effect"
import { useState, useMemo } from "react"
import { useLoaderData, useSearchParams, createSearchParams } from "react-router"
import { loader as serverLoader } from "./top-disliked.server.js"
import { Country } from "../../countries/country.js"
import { AppShell } from "../../components/app-shell/app-shell.js"
import { RankingOrderControls, HighestFirst, LowestFirst } from "../../components/ranking-order-controls/ranking-order-controls.js"
import type { RankingOrder } from "../../components/ranking-order-controls/ranking-order-controls.js"
import { RankedCountriesList } from "../../components/ranked-countries-list/ranked-countries-list.js"
import { sortCountriesByDislikes, isLowestFirst } from "./ranking.js"

export loader = serverLoader

readLoaderCountries = (payload: Unknown) =>
  direct = Schema.decodeUnknownOption(Schema.Array(Country))(payload)
  wrapped = Schema.decodeUnknownOption(Schema.Struct({ countries: Schema.optional(Schema.Array(Country)) }))(payload)
  => Option.getOrElse(direct, () => match wrapped
    | Some(result) => match Option.fromNullishOr(result.countries)
      | Some(c) => c
      | None => []
    | None => []
  )

export TopDisliked = (props: { countries?: Array<Country>, initialOrder?: RankingOrder }) =>
  loaderData = Option.try(() => useLoaderData())
  searchParams = Option.try(() => useSearchParams())
  orderFromParams = match searchParams
    | Some([params, _]) => match params.get("order") #= "lowest-first"
      | true => LowestFirst
      | false => HighestFirst
    | None => HighestFirst
  initialOrder = match props.initialOrder
    | Some(order) => order
    | None => orderFromParams
  [order, setOrder] = useState(initialOrder)
  countries = match props.countries
    | Some(c) => c
    | None => match loaderData
      | Some(payload) => readLoaderCountries(payload)
      | None => []
  lowest = isLowestFirst(order)
  displayedCountries = useMemo(() => sortCountriesByDislikes(countries, order), [countries, order])
  handleOrderChange = (nextOrder: RankingOrder) =>
    setOrder(nextOrder)
    match searchParams
      | Some([_, setSearchParams]) =>
        setSearchParams((prev: URLSearchParams) =>
          baseRecord = Record.fromEntries(prev.entries()) |> Record.remove("order")
          updated = match isLowestFirst(nextOrder)
            | true => baseRecord |> Record.set("order", "lowest-first")
            | false => baseRecord
          => createSearchParams(updated)
        , { replace: true })
      | None => false
    => nextOrder
  rankNumberOrder = match lowest
    | true => "lowest-first"
    | false => "highest-first"
  content = match displayedCountries.length #= 0
    | true => <p className="py-12 text-center text-sm font-semibold text-neutral-600">No countries available.</p>
    | false => <RankedCountriesList
        ariaLabel="Top Disliked Countries"
        countries={displayedCountries}
        rankNumberOrder={rankNumberOrder}
        rankTone="dislike"
      />
  => <AppShell>
    <div className="space-y-6">
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b-2 border-black pb-4">
        <div>
          <h1 className="text-3xl font-black tracking-tight sm:text-4xl">Top Disliked Countries</h1>
          <p className="mt-1 text-sm font-medium text-neutral-700">Community picks ranked by total dislikes</p>
        </div>
        <RankingOrderControls order={order} currentOrder={order} onOrderChange={handleOrderChange} />
      </div>
      {content}
    </div>
  </AppShell>

export default TopDisliked
