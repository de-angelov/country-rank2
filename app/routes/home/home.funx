import { useState, useMemo, useEffect } from "react"
import { useLoaderData, useSearchParams } from "react-router"
import { AppShell } from "../../components/app-shell/app-shell.js"
import { RankedCountriesList } from "../../components/ranked-countries-list/ranked-countries-list.js"
import { loader as serverLoader, loadHomeRouteData as serverLoadHomeRouteData } from "./home.server.js"

export loader = serverLoader
export loadHomeRouteData = serverLoadHomeRouteData

export SEARCH_DEBOUNCE_MS = 200

export sortCountriesByDisplayName = (countries: Array<Country>): Array<Country> =>
  sorted = countries.slice().sort((left, right) =>
    cmp = left.name.localeCompare(right.name, "en")
    => match cmp #= 0
      | true => left.code.localeCompare(right.code, "en")
      | false => cmp
  )
  => sorted

export filterCountriesByName = (countries: Array<Country>, searchQuery: String): Array<Country> =>
  query = searchQuery.trim().toLocaleLowerCase()
  => match query.length #= 0
    | true => countries.slice()
    | false => countries.filter((country) => country.name.toLocaleLowerCase().includes(query))

ts {
  import type { Country } from "../../countries/country.js";
  import type { ChangeEvent } from "react";

  export type HomeProps = {
    countries?: readonly Country[];
    initialSearch?: string;
  };

  const safeGetLoaderCountries = (): readonly Country[] => {
    try {
      const data = useLoaderData() as { countries?: Country[] } | Country[] | undefined;
      if (!data) return [];
      if (Array.isArray(data)) return data;
      return data.countries ?? [];
    } catch {
      return [];
    }
  };

  const safeGetSearchParams = () => {
    try {
      return useSearchParams();
    } catch {
      return [new URLSearchParams(), () => {}] as const;
    }
  };

  const updateSearchQuery = (prev: URLSearchParams, query: string) => {
    const next = new URLSearchParams(prev);
    if (query) {
      next.set("q", query);
    } else {
      next.delete("q");
    }
    return next;
  };

  const syncInitialSearch = (
    initialSearch: string | undefined,
    setSearch: (s: string) => void,
    setDebounced: (s: string) => void
  ) => {
    if (initialSearch !== undefined) {
      setSearch(initialSearch);
      setDebounced(initialSearch);
    }
  };
}

export Home = (props: HomeProps) =>
  rawCountries = safeGetLoaderCountries()
  searchParamsTuple = safeGetSearchParams()
  searchParams = searchParamsTuple[0]
  setSearchParams = searchParamsTuple[1]

  queryFromParams = searchParams.get("q") or ""
  initialQuery = props.initialSearch or queryFromParams

  searchInputState = useState(initialQuery)
  searchInput = searchInputState[0]
  setSearchInput = searchInputState[1]

  debouncedState = useState(initialQuery)
  debouncedQuery = debouncedState[0]
  setDebouncedQuery = debouncedState[1]

  countries = props.countries or rawCountries
  sortedCountries = useMemo(() => sortCountriesByDisplayName(countries), [countries])
  displayedCountries = useMemo(() => filterCountriesByName(sortedCountries, debouncedQuery), [sortedCountries, debouncedQuery])

  useEffect(() => syncInitialSearch(props.initialSearch, setSearchInput, setDebouncedQuery), [props.initialSearch])

  useEffect(() =>
    timer = setTimeout(() =>
      setDebouncedQuery(searchInput)
      trimmed = searchInput.trim()
      => setSearchParams((prev: URLSearchParams) => updateSearchQuery(prev, trimmed), { replace: true })
    , SEARCH_DEBOUNCE_MS)
    => () => clearTimeout(timer)
  , [searchInput, setSearchParams])

  isEmpty = displayedCountries.length #= 0

  content = match isEmpty
    | false => <RankedCountriesList
        ariaLabel="Countries"
        countries={displayedCountries}
        rankTone="like"
      />
    | true => <p className="py-12 text-center text-sm font-semibold text-neutral-600">
        No countries matched.
      </p>

  => <AppShell>
    <div className="space-y-6">
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b-2 border-black pb-4">
        <div>
          <h1 className="text-3xl font-black tracking-tight sm:text-4xl">
            Countries
          </h1>
          <p className="mt-1 text-sm font-medium text-neutral-700">
            Browse and search country rankings
          </p>
        </div>
        <div className="w-full sm:w-72">
          <label htmlFor="country-search" className="sr-only">
            Search countries
          </label>
          <input
            id="country-search"
            name="q"
            type="search"
            value={searchInput}
            onChange={(e: ChangeEvent<HTMLInputElement>) => setSearchInput(e.target.value)}
            placeholder="Search countries..."
            aria-label="Search countries"
            className="w-full rounded-base border-2 border-border bg-white px-3 py-2 text-sm font-medium placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-black shadow-shadow"
          />
        </div>
      </div>
      {content}
    </div>
  </AppShell>

