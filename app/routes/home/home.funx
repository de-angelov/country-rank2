import { loader as serverLoader } from "./home.server.js"
import { Effect, Option, Schema, Function } from "effect"
import { useState, useMemo, useEffect } from "react"
import type { ChangeEvent } from "react"
import { Country } from "../../countries/country.js"
import { useLoaderData, useSearchParams, createSearchParams } from "react-router"
import { AppShell } from "../../components/app-shell/app-shell.js"
import { RankedCountriesList } from "../../components/ranked-countries-list/ranked-countries-list.js"
export loader = serverLoader

export SEARCH_DEBOUNCE_MS = 200

export sortCountriesByDisplayName = (countries: Array<Country>): Array<Country> =>
  sorted = countries |> Array.sort((left, right) =>
    cmp = left.name.localeCompare(right.name, "en")
    => match cmp #= 0
      | true => left.code.localeCompare(right.code, "en")
      | false => cmp
  )
  => sorted

export filterCountriesByName = (countries: Array<Country>, searchQuery: String): Array<Country> =>
  query = searchQuery |> String.trim |> String.toLowerCase
  => match query.length #= 0
    | true => countries
    | false => countries |> Array.filter((country) => country.name |> String.toLowerCase |> String.includes(query))

readLoaderCountries = (payload: Unknown) =>
  direct = Schema.decodeUnknownOption(Schema.Array(Country))(payload)
  wrapped = Schema.decodeUnknownOption(Schema.Struct({ countries: Schema.optional(Schema.Array(Country)) }))(payload)
  => Option.getOrElse(direct, () => match wrapped
    | Some(result) => match Option.fromNullishOr(result.countries)
      | Some(c) => c
      | None => []
    | None => []
  )

updateSearchQuery = (prev: URLSearchParams, query: String) =>
  entries = Array.fromIterable(prev.entries()) |> Array.filter(([k]) => k #! "q")
  match query.length #= 0
    | true => createSearchParams(entries)
    | false => createSearchParams(Array.append(entries, ["q", query]))

export Home = (props: { countries?: Array<Country>, initialSearch?: String }) =>
  loaderData = Option.try(() => useLoaderData())
  rawCountries = match loaderData
    | Some(payload) => readLoaderCountries(payload)
    | None => []
  searchParamsTuple = Option.try(() => useSearchParams())
  setSearchParams = match searchParamsTuple
    | Some([_, setSp]) => Option.some(setSp)
    | None => Option.none()
  queryFromParams = match searchParamsTuple
    | Some([params, _]) => match Option.fromNullishOr(params.get("q"))
      | Some(q) => q
      | None => ""
    | None => ""
  initialQuery = match props.initialSearch
    | Some(search) => search
    | None => queryFromParams
  initialSearch = Option.getOrUndefined(props.initialSearch)

  [searchInput, setSearchInput] = useState(initialQuery)
  [debouncedQuery, setDebouncedQuery] = useState(initialQuery)

  countries = match props.countries
    | Some(c) => c
    | None => rawCountries
  sortedCountries = useMemo(() => sortCountriesByDisplayName(countries), [countries])
  displayedCountries = useMemo(() => filterCountriesByName(sortedCountries, debouncedQuery), [sortedCountries, debouncedQuery])

  useEffect(() => match Option.fromNullishOr(initialSearch)
    | Some(value) =>
      setSearchInput(value)
      => setDebouncedQuery(value)
    | None => Function.constVoid()
  , [initialSearch])

  useEffect(() =>
    timer = setTimeout(() =>
      setDebouncedQuery(searchInput)
      trimmed = searchInput |> String.trim
      => match Option.fromNullishOr(setSearchParams)
        | Some(update) => update((prev: URLSearchParams) => updateSearchQuery(prev, trimmed), { replace: true })
        | None => Function.constVoid()
    , SEARCH_DEBOUNCE_MS)
    => () => clearTimeout(timer)
  , [searchInput, setSearchParams])

  isEmpty = displayedCountries.length #= 0

  content = match isEmpty
    | false => <RankedCountriesList
        ariaLabel="Countries"
        countries={displayedCountries}
        rankNumberOrder="highest-first"
        rankTone="like"
      />
    | true => <p className="py-12 text-center text-sm font-semibold text-neutral-600">
        No countries matched.
      </p>

  => <AppShell>
    <div className="space-y-6">
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b-2 border-black pb-4">
        <div>
          <h1 className="text-3xl font-black tracking-tight sm:text-4xl">
            Countries
          </h1>
          <p className="mt-1 text-sm font-medium text-neutral-700">
            Browse and search country rankings
          </p>
        </div>
        <div className="w-full sm:w-72">
          <label htmlFor="country-search" className="sr-only">
            Search countries
          </label>
          <input
            id="country-search"
            name="q"
            type="search"
            value={searchInput}
            onChange={(e: ChangeEvent<HTMLInputElement>) => setSearchInput(e.target.value)}
            placeholder="Search countries..."
            aria-label="Search countries"
            className="w-full rounded-base border-2 border-border bg-white px-3 py-2 text-sm font-medium placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-black shadow-shadow"
          />
        </div>
      </div>
      {content}
    </div>
  </AppShell>


export default Home
