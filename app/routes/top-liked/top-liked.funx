import { loader as serverLoader } from "./top-liked.server.js"
export loader = serverLoader
import { AppShell } from "../../components/app-shell/app-shell.js"
import { RankingOrderControls, HighestFirst, LowestFirst } from "../../components/ranking-order-controls/ranking-order-controls.js"
import { RankedCountriesList } from "../../components/ranked-countries-list/ranked-countries-list.js"

ts {
  import * as React from "react";
  import { useLoaderData, useSearchParams } from "react-router";
  import type { Country } from "../../countries/country.js";
  import type { RankingOrder } from "../../components/ranking-order-controls/ranking-order-controls.js";
  import { sortCountriesByLikes, isLowestFirst } from "./ranking.js";

  export interface TopLikedProps {
    countries?: readonly Country[];
    initialOrder?: RankingOrder;
  }

  export function TopLiked(props: TopLikedProps) {
    const loaderData = (() => {
      try {
        return useLoaderData() as { countries?: Country[] } | Country[] | undefined;
      } catch {
        return undefined;
      }
    })();

    const searchParams = (() => {
      try {
        const [params] = useSearchParams();
        return params;
      } catch {
        return undefined;
      }
    })();

    const [, setSearchParams] = (() => {
      try {
        return useSearchParams();
      } catch {
        return [undefined, undefined];
      }
    })();

    const [order, setOrder] = React.useState<RankingOrder>(() => {
      if (props?.initialOrder) return props.initialOrder;
      if (searchParams && searchParams.get("order") === "lowest-first") {
        return LowestFirst;
      }
      return HighestFirst;
    });

    const countries =
      props?.countries ??
      (Array.isArray(loaderData) ? loaderData : loaderData?.countries) ??
      [];

    const lowest = isLowestFirst(order);

    const displayedCountries = React.useMemo(() => {
      return sortCountriesByLikes(countries, order);
    }, [countries, order]);

    const handleOrderChange = (nextOrder: RankingOrder) => {
      setOrder(nextOrder);
      if (typeof setSearchParams === "function") {
        const isLowest = isLowestFirst(nextOrder);
        setSearchParams(
          (prev) => {
            const next = new URLSearchParams(prev);
            if (isLowest) {
              next.set("order", "lowest-first");
            } else {
              next.delete("order");
            }
            return next;
          },
          { replace: true }
        );
      }
    };

    return (
      <AppShell>
        <div className="space-y-6">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b-2 border-black pb-4">
            <div>
              <h1 className="text-3xl font-black tracking-tight sm:text-4xl">
                Top Liked Countries
              </h1>
              <p className="mt-1 text-sm font-medium text-neutral-700">
                Community favorites ranked by total likes
              </p>
            </div>
            <RankingOrderControls
              order={order}
              currentOrder={order}
              onOrderChange={handleOrderChange}
            />
          </div>

          {displayedCountries.length === 0 ? (
            <p className="py-12 text-center text-sm font-semibold text-neutral-600">
              No countries available.
            </p>
          ) : (
            <RankedCountriesList
              ariaLabel="Top Liked Countries"
              countries={displayedCountries}
              rankNumberOrder={lowest ? "lowest-first" : "highest-first"}
              rankTone="like"
            />
          )}
        </div>
      </AppShell>
    );
  }

  export default TopLiked;
}
